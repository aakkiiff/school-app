# Media/profile service (Node) - copy to .env
PORT=5004
FRONTEND_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://school-db-admin:change-me-to-a-long-random-secret@localhost:27017/kindergarten?authSource=admin
DATABASE_NAME=kindergarten

# RustFS (S3-compatible) - same keys as OBJECT_STORAGE_* in the root .env
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=school-storage-admin
S3_SECRET_KEY=change-me-to-a-long-random-secret
S3_BUCKET=school-media
S3_THUMBNAIL_BUCKET=school-thumbnails
# Empty = return direct signed RustFS URLs
S3_PUBLIC_PATH=

# RabbitMQ - amqp://USER:PASSWORD@HOST:PORT (same as RABBITMQ_* in the root .env)
RABBITMQ_URL=amqp://school-queue-admin:change-me-to-a-long-random-secret@localhost:5672
