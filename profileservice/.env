# Media/profile service (Node)
PORT=5004
FRONTEND_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://myUser:myPassword@mongo:27017/kindergarten?authSource=admin
DATABASE_NAME=kindergarten

# RustFS (S3-compatible) - same keys as OBJECT_STORAGE_* in the root .env
S3_ENDPOINT=http://object-storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=school-storage-admin
S3_SECRET_KEY=7ad1de1ac2cb02d4ad5bd5c586c877607b36b73e
S3_BUCKET=school-media
S3_THUMBNAIL_BUCKET=school-thumbnails
# Empty = return direct signed RustFS URLs
S3_PUBLIC_PATH=

# RabbitMQ - amqp://USER:PASSWORD@HOST:PORT (same as RABBITMQ_* in the root .env)
RABBITMQ_URL=amqp://school-queue-admin:a291d358513a8467ccc6ebe641f71b20b8b9a114ec5fe816@rabbitmq:5672
