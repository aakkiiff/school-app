# RustFS (S3) root credentials; also the console login at http://localhost:9001/rustfs/console/
OBJECT_STORAGE_ACCESS_KEY=school-storage-admin
OBJECT_STORAGE_SECRET_KEY=change-me-to-a-long-random-secret

# RabbitMQ (use URL-safe characters); console: http://localhost:15672
RABBITMQ_USER=school-queue-admin
RABBITMQ_PASSWORD=change-me-to-a-long-random-secret

# MongoDB root user (use URL-safe characters)
MONGO_ROOT_USERNAME=school-db-admin
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-secret
